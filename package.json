    "@vitejs/plugin-vue": "5.1.4",
    "@vue/tsconfig": "0.8.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "storybook": "8.4.7",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "5.4.11",
